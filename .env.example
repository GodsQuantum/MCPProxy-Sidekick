# Copy to .env and adjust for your deployment.
MCPPROXY_CONTAINER_NAME=mcpproxy
SIDEKICK_PUBLIC_BASE_URL=https://mcp.example.com/control/
SIDEKICK_ALLOWED_HOSTS=mcp.example.com
SIDEKICK_SESSION_LIFETIME=720h
# Optional adapter endpoints for special auth layouts:
SIDEKICK_POSTIZ_BASE_URL=
SIDEKICK_PAPERLESS_ENDPOINT=
PUID=1000
PGID=1000
TZ=UTC

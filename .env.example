# Copy to .env and adjust for your deployment.
MCPPROXY_CONTAINER_NAME=mcpproxy
SIDEKICK_PUBLIC_BASE_URL=https://mcp.example.com/control/
SIDEKICK_ALLOWED_HOSTS=mcp.example.com
SIDEKICK_SESSION_LIFETIME=720h
SIDEKICK_OAUTH_CDP_URL=http://127.0.0.1:9222
SIDEKICK_BROWSER_PROVIDER=chromium
SIDEKICK_BROWSER_INSTANCE=default
# Optional JSON registry of server-declared browser instances; CDP URLs never reach the frontend.
# SIDEKICK_BROWSER_INSTANCES_JSON=[{"id":"playwright-primary","label":"Playwright Primary","cdp_url":"http://127.0.0.1:9222","browser_url":"/control/oauth-browser/"}]
SIDEKICK_BROWSER_IMAGE=lscr.io/linuxserver/chromium:latest
SIDEKICK_BROWSER_PROFILE_DIR=chromium-sidekick-oauth
# off | assist | managed-extension
SIDEKICK_BITWARDEN_MODE=off
# Optional HTTPS URL for self-hosted Bitwarden/Vaultwarden (for example https://vault.example.com).
SIDEKICK_BITWARDEN_BASE_URL=
SIDEKICK_CDP_RELAY_ENABLE=false
SIDEKICK_CDP_RELAY_HOST=0.0.0.0
SIDEKICK_CDP_RELAY_PORT=9223
SIDEKICK_CDP_TARGET_HOST=127.0.0.1
SIDEKICK_CDP_TARGET_PORT=9222
# Optional adapter endpoints for special auth layouts:
SIDEKICK_POSTIZ_BASE_URL=
SIDEKICK_PAPERLESS_ENDPOINT=
SIDEKICK_OMNIROUTE_DB=
# Optional write-only API-key target for an upstream named openalex-github.
SIDEKICK_OPENALEX_KEY_FILE=
SIDEKICK_YOUTUBE_OAUTH_CONTROL_URL=
# Optional generic secure handoff settings for deployment-specific credential adapters.
SIDEKICK_CREDENTIAL_PENDING_HOST_DIR=
SIDEKICK_CREDENTIAL_SSH_TRANSFER_ROOT=
SIDEKICK_CREDENTIAL_SOURCE_SSH_PROFILE=
# Optional Crypto.com private gateway handoff. Keep secrets out of this file.
SIDEKICK_CRYPTOCOM_REMOTE_ENV_PATH=
SIDEKICK_CRYPTOCOM_REMOTE_COMPOSE_DIR=
SIDEKICK_CRYPTOCOM_REMOTE_USER=
SIDEKICK_CRYPTOCOM_REMOTE_SSH_PROFILE=
# Optional Dify native MCP credential handoff.
SIDEKICK_DIFY_REMOTE_SSH_PROFILE=
SIDEKICK_DIFY_APPLY_HELPER_PATH=
# JSON map: MCPProxy profile -> Dify provider ID + enforced permission list.
# SIDEKICK_DIFY_BINDINGS_JSON={"research":{"provider_id":"provider-id","permissions":["read"]}}
PUID=1000
PGID=1000
TZ=UTC
